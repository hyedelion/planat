<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.hml.planat.mappers.ContactMvnoMapper">
    <select id="selectAll" resultType="com.hml.planat.entities.users.ContactMvnoEntity">
        SELECT `code`         AS `code`,
               `display_text` AS `displayText`
        FROM `planat`.`contact_mvnos`
    </select>
</mapper>